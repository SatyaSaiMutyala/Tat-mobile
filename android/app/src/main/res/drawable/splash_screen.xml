<?xml version="1.0" encoding="utf-8"?>
<!--
  Native splash shown from launch until React Native has mounted. Without it the
  window is plain white for that gap, which reads as a flash against the deep
  green JS splash that follows.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_background" />

    <item>
        <bitmap
            android:src="@mipmap/ic_launcher"
            android:gravity="center" />
    </item>
</layer-list>
